local function makeToggleButton(text, yPos)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0, 190, 0, 44)
    btn.Position         = UDim2.new(0.5, -95, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    btn.BorderSizePixel  = 0
    btn.Text             = "▶  " .. text .. "  [ВЫКЛ]"
    btn.TextColor3       = Color3.fromRGB(160, 160, 180)
    btn.Font             = Enum.Font.GothamSemibold
    btn.TextSize         = 13
    btn.Parent           = frame

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 8)
    bCorner.Parent       = btn

    local bStroke = Instance.new("UIStroke")
    bStroke.Color     = Color3.fromRGB(60, 60, 90)
    bStroke.Thickness = 1
    bStroke.Parent    = btn

    return btn, bStroke
end

local zombieBtn, zombieStroke = makeToggleButton("🧟 Зомби",  48)
local beeBtn,    beeStroke    = makeToggleButton("🐝 Пчёлы", 102)

zombieBtn.MouseButton1Click:Connect(function()
    zombieActive = not zombieActive
    if zombieActive then
        startZombie()
        zombieBtn.Text             = "■  🧟 Зомби  [ВКЛ]"
        zombieBtn.TextColor3       = Color3.fromRGB(100, 255, 140)
        zombieBtn.BackgroundColor3 = Color3.fromRGB(10, 40, 20)
        zombieStroke.Color         = Color3.fromRGB(60, 200, 100)
    else
        stopZombie()
        zombieBtn.Text             = "▶  🧟 Зомби  [ВЫКЛ]"
        zombieBtn.TextColor3       = Color3.fromRGB(160, 160, 180)
        zombieBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
        zombieStroke.Color         = Color3.fromRGB(60, 60, 90)
    end
end)

beeBtn.MouseButton1Click:Connect(function()
    beeActive = not beeActive
    if beeActive then
        startBees()
        beeBtn.Text             = "■  🐝 Пчёлы  [ВКЛ]"
        beeBtn.TextColor3       = Color3.fromRGB(255, 220, 80)
        beeBtn.BackgroundColor3 = Color3.fromRGB(40, 35, 0)
        beeStroke.Color         = Color3.fromRGB(220, 180, 30)
    else
        stopBees()
        beeBtn.Text             = "▶  🐝 Пчёлы  [ВЫКЛ]"
        beeBtn.TextColor3       = Color3.fromRGB(160, 160, 180)
        beeBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
        beeStroke.Color         = Color3.fromRGB(60, 60, 90)
    end
end)

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart  = newChar:WaitForChild("HumanoidRootPart")
    if zombieActive then stopZombie(); zombieActive = true; startZombie() end
    if beeActive    then stopBees();   beeActive    = true; startBees()  end
end)
