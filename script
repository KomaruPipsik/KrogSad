-- AutoScript.lua
-- LocalScript → StarterPlayerScripts

local Players       = game:GetService("Players")
local RunService    = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace     = game:GetService("Workspace")

local player    = Players.LocalPlayer
local camera    = Workspace.CurrentCamera
local character = player.Character or player.CharacterAdded:Wait()
local rootPart  = character:WaitForChild("HumanoidRootPart")

local InteractiveEvents = Workspace:WaitForChild("InteractiveEvents")

-- ========================
--   КЭШИРОВАННЫЕ ПАПКИ
-- ========================
local plantRuntime    = nil
local honeycombFolder = nil

task.spawn(function()
    local ok, plantRush = pcall(function() return InteractiveEvents:WaitForChild("PlantRush", 10) end)
    if ok and plantRush then
        local ok2, rt = pcall(function() return plantRush:WaitForChild("Runtime", 10) end)
        if ok2 then plantRuntime = rt end
    end
end)

task.spawn(function()
    local ok, queenBee = pcall(function() return InteractiveEvents:WaitForChild("QueenBee", 10) end)
    if ok and queenBee then
        local ok2, rt = pcall(function() return queenBee:WaitForChild("RuntimeHoneycombs", 10) end)
        if ok2 then honeycombFolder = rt end
    end
end)

-- ========================
--       СТЕЙТ
-- ========================
local zombieActive = false
local beeActive    = false
local afkActive    = false
local zombieConn   = nil
local afkConn      = nil
local platforms    = {}

-- ========================
--    ЗОМБИ — aimbot
-- ========================
-- Находим ближайший Plant к игроку и наводим камеру на него

local plantNames = {
    ["Small Plant"]  = true,
    ["Medium Plant"] = true,
    ["Tough Plant"]  = true,
    ["Boss Plant"]   = true,
}

local zombieTimer    = 0
local ZOMBIE_INTERVAL = 0.1  -- обновление каждые 0.1 сек

local function getNearestPlant()
    if not plantRuntime then return nil end
    local myPos = rootPart.Position
    local nearest, bestDist = nil, math.huge
    -- GetChildren() — только прямые дети, быстро
    for _, child in ipairs(plantRuntime:GetChildren()) do
        if plantNames[child.Name] then
            local part = nil
            if child:IsA("Model") then
                part = child.PrimaryPart
            elseif child:IsA("BasePart") then
                part = child
            end
            if part then
                local d = (part.Position - myPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    nearest  = part
                end
            end
        end
    end
    return nearest
end

local function startZombie()
    -- Переключаем камеру в Scriptable чтобы управлять ею
    camera.CameraType = Enum.CameraType.Scriptable

    zombieConn = RunService.RenderStepped:Connect(function(dt)
        if not zombieActive then return end

        zombieTimer = zombieTimer + dt
        if zombieTimer < ZOMBIE_INTERVAL then return end
        zombieTimer = 0

        local target = getNearestPlant()
        if target and rootPart then
            -- Наводим камеру: позиция за спиной игрока, смотрит на цель
            local myPos    = rootPart.Position + Vector3.new(0, 2, 0)
            local targetPos = target.Position

            -- Плавный LookAt
            local desiredCF = CFrame.new(myPos, targetPos)
            camera.CFrame   = desiredCF
        end
    end)
end

local function stopZombie()
    zombieActive = false
    if zombieConn then
        zombieConn:Disconnect()
        zombieConn = nil
    end
    zombieTimer = 0
    -- Возвращаем камеру в обычный режим
    camera.CameraType = Enum.CameraType.Custom
end

-- ========================
--  ПЧЁЛЫ — платформы
-- ========================
local PLATFORM_SIZE   = Vector3.new(10, 1, 10)
local PLATFORM_OFFSET = Vector3.new(0, -2, 0)

local function createPlatform(honeycomb)
    if platforms[honeycomb] then return end
    local target = (honeycomb:IsA("Model") and honeycomb.PrimaryPart) or
                   (honeycomb:IsA("BasePart") and honeycomb)
    if not target then return end

    local part = Instance.new("Part")
    part.Name         = "HoneycombPlatform"
    part.Size         = PLATFORM_SIZE
    part.Anchored     = true
    part.CanCollide   = true
    part.CastShadow   = false
    part.Material     = Enum.Material.SmoothPlastic
    part.Color        = Color3.fromRGB(255, 200, 50)
    part.Transparency = 0.25
    part.CFrame       = CFrame.new(target.Position + PLATFORM_OFFSET)
    part.Parent       = Workspace
    platforms[honeycomb] = part

    honeycomb.AncestryChanged:Connect(function(_, newParent)
        if newParent == nil and platforms[honeycomb] then
            platforms[honeycomb]:Destroy()
            platforms[honeycomb] = nil
        end
    end)
end

local function removeAllPlatforms()
    for comb, plat in pairs(platforms) do
        if plat and plat.Parent then plat:Destroy() end
        platforms[comb] = nil
    end
end

local honeycombAddedConn   = nil
local honeycombRemovedConn = nil

local function watchHoneycombs()
    if not honeycombFolder then return end
    for _, child in ipairs(honeycombFolder:GetChildren()) do
        if child.Name == "Honeycomb" then createPlatform(child) end
    end
    honeycombAddedConn = honeycombFolder.ChildAdded:Connect(function(child)
        if child.Name == "Honeycomb" then task.wait(0.05); createPlatform(child) end
    end)
    honeycombRemovedConn = honeycombFolder.ChildRemoved:Connect(function(child)
        if platforms[child] then platforms[child]:Destroy(); platforms[child] = nil end
    end)
end

local function unwatchHoneycombs()
    if honeycombAddedConn   then honeycombAddedConn:Disconnect();   honeycombAddedConn   = nil end
    if honeycombRemovedConn then honeycombRemovedConn:Disconnect(); honeycombRemovedConn = nil end
    removeAllPlatforms()
end

-- ========================
--    ПЧЁЛЫ — телепорт
-- ========================
local function pressE()
    local vInput = game:GetService("VirtualInputManager")
    if vInput then
        vInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(1)
        vInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    else
        task.wait(1)
    end
end

local function getNearestHoneycomb()
    if not honeycombFolder then return nil end
    local pos = rootPart.Position
    local nearest, bestDist = nil, math.huge
    for _, comb in ipairs(honeycombFolder:GetChildren()) do
        if comb.Name == "Honeycomb" then
            local part = (comb:IsA("Model") and comb.PrimaryPart) or
                         (comb:IsA("BasePart") and comb)
            if part then
                local d = (part.Position - pos).Magnitude
                if d < bestDist then bestDist = d; nearest = part end
            end
        end
    end
    return nearest
end

local function startBees()
    task.spawn(function()
        local tries = 0
        while not honeycombFolder and tries < 20 do task.wait(0.5); tries += 1 end
        watchHoneycombs()
    end)
    task.spawn(function()
        while beeActive do
            local nearest = getNearestHoneycomb()
            if nearest then
                rootPart.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 4, 0))
                pressE()
                task.wait(0.2)
            else
                task.wait(0.5)
            end
        end
    end)
end

local function stopBees()
    beeActive = false
    unwatchHoneycombs()
end

-- ========================
--      АНТИ-АФК
-- ========================
-- Каждые 60 сек делаем мелкое движение мышью — сбрасывает таймер АФК Roblox

local afkTimer = 0
local AFK_INTERVAL = 60

local function startAntiAfk()
    afkConn = RunService.Heartbeat:Connect(function(dt)
        if not afkActive then return end
        afkTimer = afkTimer + dt
        if afkTimer < AFK_INTERVAL then return end
        afkTimer = 0
        -- Имитируем небольшое движение камеры
        local vInput = game:GetService("VirtualInputManager")
        if vInput then
            vInput:SendMouseButtonEvent(0, 0, 0, true,  game, 1)
            vInput:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            vInput:SendMouseMoveEvent(1, 0, game)
            task.wait(0.05)
            vInput:SendMouseMoveEvent(-1, 0, game)
        end
    end)
end

local function stopAntiAfk()
    afkActive = false
    if afkConn then afkConn:Disconnect(); afkConn = nil end
    afkTimer = 0
end

