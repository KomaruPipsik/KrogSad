-- AutoScript.lua
-- LocalScript → StarterPlayerScripts
-- Фикс: кэш папок (нет WaitForChild в Heartbeat), платформы под Honeycomb

local Players            = game:GetService("Players")
local RunService         = game:GetService("RunService")
local Workspace          = game:GetService("Workspace")

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart  = character:WaitForChild("HumanoidRootPart")

local InteractiveEvents  = Workspace:WaitForChild("InteractiveEvents")

-- ========================
--   КЭШИРОВАННЫЕ ПАПКИ
-- ========================
-- Получаем один раз — никаких WaitForChild внутри Heartbeat
local plantRuntime    = nil
local honeycombFolder = nil

task.spawn(function()
    local plantRush = InteractiveEvents:WaitForChild("PlantRush")
    plantRuntime    = plantRush:WaitForChild("Runtime")
end)

task.spawn(function()
    local queenBee   = InteractiveEvents:WaitForChild("QueenBee")
    honeycombFolder  = queenBee:WaitForChild("RuntimeHoneycombs")
end)

-- ========================
--       СТЕЙТ
-- ========================
local zombieActive = false
local beeActive    = false
local zombieConn   = nil

-- Платформы под Honeycomb: [модель] = Part
local platforms = {}

-- ========================
--    ЗОМБИ — PlantRush
-- ========================
local plantNames = {
    ["Small Plant"]  = true,
    ["Medium Plant"] = true,
    ["Tough Plant"]  = true,
    ["Boss Plant"]   = true,
}

-- Интервал обновления зомби — каждые 0.1 сек, не каждый кадр
local zombieTimer = 0
local ZOMBIE_INTERVAL = 0.1

local function getMonsters()
    local monsters = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local h = obj:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if root then
                    monsters[#monsters + 1] = root
                end
            end
        end
    end
    return monsters
end

local function startZombie()
    zombieConn = RunService.Heartbeat:Connect(function(dt)
        if not zombieActive then return end
        zombieTimer = zombieTimer + dt
        if zombieTimer < ZOMBIE_INTERVAL then return end
        zombieTimer = 0

        if not plantRuntime then return end

        -- Собираем растения
        local plants = {}
        for _, child in ipairs(plantRuntime:GetChildren()) do
            if plantNames[child.Name] and child:IsA("Model") and child.PrimaryPart then
                plants[#plants + 1] = child
            end
        end
        if #plants == 0 then return end

        local monsters = getMonsters()
        if #monsters == 0 then return end

        for _, plant in ipairs(plants) do
            local pp = plant.PrimaryPart
            local bestMon, bestDist = nil, math.huge
            for _, mRoot in ipairs(monsters) do
                if mRoot and mRoot.Parent then
                    local d = (mRoot.Position - pp.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestMon  = mRoot
                    end
                end
            end
            if bestMon then
                -- Поворачиваем только по горизонтали
                local dir = (bestMon.Position - pp.Position) * Vector3.new(1, 0, 1)
                if dir.Magnitude > 0.1 then
                    plant:SetPrimaryPartCFrame(
                        CFrame.new(pp.Position, pp.Position + dir.Unit)
                    )
                end
            end
        end
    end)
end

local function stopZombie()
    zombieActive = false
    if zombieConn then
        zombieConn:Disconnect()
        zombieConn = nil
    end
    zombieTimer = 0
end

-- ========================
--  ПЧЁЛЫ — платформы
-- ========================
local PLATFORM_SIZE    = Vector3.new(10, 1, 10)
local PLATFORM_COLOR   = Color3.fromRGB(255, 200, 50)
local PLATFORM_OFFSET  = Vector3.new(0, -2, 0) -- чуть ниже центра модели

local function createPlatform(honeycomb)
    -- Если уже есть — не дублируем
    if platforms[honeycomb] then return end

    local part = Instance.new("Part")
    part.Name          = "HoneycombPlatform"
    part.Size          = PLATFORM_SIZE
    part.Anchored      = true
    part.CanCollide    = true
    part.CastShadow    = false
    part.Material      = Enum.Material.SmoothPlastic
    part.BrickColor    = BrickColor.new("Bright yellow")
    part.Color         = PLATFORM_COLOR
    part.Transparency  = 0.25

    local uiCorner = Instance.new("SpecialMesh")
    uiCorner.MeshType = Enum.MeshType.Brick
    uiCorner.Parent   = part

    -- Позиция: под центром модели
    local target = honeycomb:IsA("Model") and honeycomb.PrimaryPart or honeycomb
    if not target then part:Destroy(); return end

    part.CFrame = CFrame.new(target.Position + PLATFORM_OFFSET)
    part.Parent = Workspace

    platforms[honeycomb] = part

    -- Удаляем платформу когда honeycomb пропадает
    honeycomb.AncestryChanged:Connect(function(_, newParent)
        if newParent == nil then
            if platforms[honeycomb] then
                platforms[honeycomb]:Destroy()
                platforms[honeycomb] = nil
            end
        end
    end)
end

local function removePlatform(honeycomb)
    if platforms[honeycomb] then
        platforms[honeycomb]:Destroy()
        platforms[honeycomb] = nil
    end
end

local function removeAllPlatforms()
    for comb, plat in pairs(platforms) do
        if plat and plat.Parent then plat:Destroy() end
        platforms[comb] = nil
    end
end

-- Следим за появлением новых Honeycomb
local honeycombAddedConn   = nil
local honeycombRemovedConn = nil

local function watchHoneycombs()
    if not honeycombFolder then return end

    -- Платформы под уже существующими
    for _, child in ipairs(honeycombFolder:GetChildren()) do
        if child.Name == "Honeycomb" then
            createPlatform(child)
        end
    end

    honeycombAddedConn = honeycombFolder.ChildAdded:Connect(function(child)
        if child.Name == "Honeycomb" then
            task.wait(0.05) -- дать модели загрузиться
            createPlatform(child)
        end
    end)

    honeycombRemovedConn = honeycombFolder.ChildRemoved:Connect(function(child)
        removePlatform(child)
    end)
end

local function unwatchHoneycombs()
    if honeycombAddedConn   then honeycombAddedConn:Disconnect();   honeycombAddedConn   = nil end
    if honeycombRemovedConn then honeycombRemovedConn:Disconnect(); honeycombRemovedConn = nil end
    removeAllPlatforms()
end

-- ========================
--    ПЧЁЛЫ — телепорт
-- ========================
local function pressE()
    local vInput = game:GetService("VirtualInputManager")
    if vInput then
        vInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(1)
        vInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    else
        task.wait(1)
    end
end

local function getNearestHoneycomb()
    if not honeycombFolder then return nil end
    local pos = rootPart.Position
    local nearest, bestDist = nil, math.huge
    for _, comb in ipairs(honeycombFolder:GetChildren()) do
        if comb.Name == "Honeycomb" then
            local part = comb:IsA("Model") and comb.PrimaryPart or (comb:IsA("BasePart") and comb)
            if part then
                local d = (part.Position - pos).Magnitude
                if d < bestDist then
                    bestDist = d
                    nearest  = part
                end
            end
        end
    end
    return nearest
end

local function startBees()
    -- Сначала ставим платформы
    task.spawn(function()
        -- Ждём пока папка загрузится если ещё нет
        local tries = 0
        while not honeycombFolder and tries < 20 do
            task.wait(0.5)
            tries = tries + 1
        end
        watchHoneycombs()
    end)

    task.spawn(function()
        while beeActive do
            local nearest = getNearestHoneycomb()
            if nearest then
                -- Телепортируем на платформу (на 2 выше низа платформы)
                rootPart.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 4, 0))
                pressE()
                task.wait(0.2)
            else
                task.wait(0.5)
            end
        end
    end)
end

local function stopBees()
    beeActive = false
    unwatchHoneycombs()
end

