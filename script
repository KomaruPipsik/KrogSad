-- Функция создания кнопки-тогла
local function makeToggleButton(text, yPos)
    local btn = Instance.new("TextButton")
    btn.Size              = UDim2.new(0, 190, 0, 44)
    btn.Position          = UDim2.new(0.5, -95, 0, yPos)
    btn.BackgroundColor3  = Color3.fromRGB(25, 25, 40)
    btn.BorderSizePixel   = 0
    btn.Text              = "▶  " .. text .. "  [ВЫКЛ]"
    btn.TextColor3        = Color3.fromRGB(160, 160, 180)
    btn.Font              = Enum.Font.GothamSemibold
    btn.TextSize          = 13
    btn.Parent            = frame

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 8)
    bCorner.Parent       = btn

    local bStroke = Instance.new("UIStroke")
    bStroke.Color        = Color3.fromRGB(60, 60, 90)
    bStroke.Thickness    = 1
    bStroke.Parent       = btn

    return btn, bStroke
end

