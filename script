local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local Workspace        = game:GetService("Workspace")

local player    = Players.LocalPlayer
local camera    = Workspace.CurrentCamera
local character = player.Character or player.CharacterAdded:Wait()
local rootPart  = character:WaitForChild("HumanoidRootPart")

local InteractiveEvents = Workspace:WaitForChild("InteractiveEvents")

-- грузим папки один раз чтоб потом не тормозило
local plantRuntime    = nil
local honeycombFolder = nil

task.spawn(function()
    local ok, plantRush = pcall(function() return InteractiveEvents:WaitForChild("PlantRush", 10) end)
    if ok and plantRush then
        local ok2, rt = pcall(function() return plantRush:WaitForChild("Runtime", 10) end)
        if ok2 then plantRuntime = rt end
    end
end)

task.spawn(function()
    local ok, queenBee = pcall(function() return InteractiveEvents:WaitForChild("QueenBee", 10) end)
    if ok and queenBee then
        local ok2, rt = pcall(function() return queenBee:WaitForChild("RuntimeHoneycombs", 10) end)
        if ok2 then honeycombFolder = rt end
    end
end)

local plantKillActive = false
local beeActive       = false
local afkActive       = false

local plantKillConn   = nil
local afkConn         = nil

local platforms = {}

-- ================================================
--   АВТО УБИЙСТВО РАСТЕНИЙ
-- ================================================

local plantNames = {
    ["Small Plant"]  = true,
    ["Medium Plant"] = true,
    ["Tough Plant"]  = true,
    ["Boss Plant"]   = true,
}

local function getNearestPlant()
    if not plantRuntime then return nil end
    local myPos = rootPart.Position
    local nearest, bestDist = nil, math.huge
    for _, child in ipairs(plantRuntime:GetChildren()) do
        if plantNames[child.Name] then
            local part = child:IsA("Model") and child.PrimaryPart
                      or child:IsA("BasePart") and child
                      or nil
            if part then
                local d = (part.Position - myPos).Magnitude
                if d < bestDist then
                    bestDist = d
                    nearest  = part
                end
            end
        end
    end
    return nearest
end

local function equipTomatoShooter()
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChild("Tomato Shooter")
        if tool then
            tool.Parent = character
            return true
        end
    end
    if character:FindFirstChild("Tomato Shooter") then
        return true
    end
    return false
end

local aimTimer = 0
local AIM_RATE = 0.05

local function startPlantKill()
    plantKillConn = RunService.RenderStepped:Connect(function(dt)
        if not plantKillActive then return end

        local hasGun = equipTomatoShooter()
        if not hasGun then return end

        aimTimer = aimTimer + dt
        if aimTimer < AIM_RATE then return end
        aimTimer = 0

        local target = getNearestPlant()
        if not target or not rootPart then return end

        local myPos     = rootPart.Position + Vector3.new(0, 1.5, 0)
        local targetPos = target.Position

        local back   = (myPos - targetPos).Unit * 8
        local camPos = myPos + back + Vector3.new(0, 2, 0)

        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame     = CFrame.new(camPos, targetPos)
    end)
end

local function stopPlantKill()
    plantKillActive = false
    if plantKillConn then
        plantKillConn:Disconnect()
        plantKillConn = nil
    end
    aimTimer = 0
    camera.CameraType = Enum.CameraType.Custom
end

-- ================================================
--   ПЧЁЛЫ
-- ================================================

local function createPlatform(honeycomb)
    if platforms[honeycomb] then return end
    local target = honeycomb:IsA("Model") and honeycomb.PrimaryPart
                or honeycomb:IsA("BasePart") and honeycomb
                or nil
    if not target then return end

    local part = Instance.new("Part")
    part.Name         = "HoneycombPlatform"
    part.Size         = Vector3.new(10, 1, 10)
    part.Anchored     = true
    part.CanCollide   = true
    part.CastShadow   = false
    part.Material     = Enum.Material.SmoothPlastic
    part.Color        = Color3.fromRGB(255, 200, 50)
    part.Transparency = 0.25
    part.CFrame       = CFrame.new(target.Position + Vector3.new(0, -2, 0))
    part.Parent       = Workspace
    platforms[honeycomb] = part

    honeycomb.AncestryChanged:Connect(function(_, newParent)
        if newParent == nil and platforms[honeycomb] then
            platforms[honeycomb]:Destroy()
            platforms[honeycomb] = nil
        end
    end)
end

local function removeAllPlatforms()
    for comb, plat in pairs(platforms) do
        if plat and plat.Parent then plat:Destroy() end
        platforms[comb] = nil
    end
end

local honeycombAddedConn   = nil
local honeycombRemovedConn = nil

local function watchHoneycombs()
    if not honeycombFolder then return end
    for _, child in ipairs(honeycombFolder:GetChildren()) do
        if child.Name == "Honeycomb" then createPlatform(child) end
    end
    honeycombAddedConn = honeycombFolder.ChildAdded:Connect(function(child)
        if child.Name == "Honeycomb" then task.wait(0.05); createPlatform(child) end
    end)
    honeycombRemovedConn = honeycombFolder.ChildRemoved:Connect(function(child)
        if platforms[child] then platforms[child]:Destroy(); platforms[child] = nil end
    end)
end

local function unwatchHoneycombs()
    if honeycombAddedConn   then honeycombAddedConn:Disconnect();   honeycombAddedConn   = nil end
    if honeycombRemovedConn then honeycombRemovedConn:Disconnect(); honeycombRemovedConn = nil end
    removeAllPlatforms()
end

local function pressE()
    local vInput = game:GetService("VirtualInputManager")
    if vInput then
        vInput:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(1)
        vInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    else
        task.wait(1)
    end
end

local function getNearestHoneycomb()
    if not honeycombFolder then return nil end
    local pos = rootPart.Position
    local nearest, bestDist = nil, math.huge
    for _, comb in ipairs(honeycombFolder:GetChildren()) do
        if comb.Name == "Honeycomb" then
            local part = comb:IsA("Model") and comb.PrimaryPart
                      or comb:IsA("BasePart") and comb
                      or nil
            if part then
                local d = (part.Position - pos).Magnitude
                if d < bestDist then bestDist = d; nearest = part end
            end
        end
    end
    return nearest
end

local function startBees()
    task.spawn(function()
        -- ждём папку если ещё не загрузилась
        local tries = 0
        while not honeycombFolder and tries < 20 do
            task.wait(0.5)
            tries += 1
        end
        if not beeActive then return end
        watchHoneycombs()

        while beeActive do
            local nearest = getNearestHoneycomb()
            if nearest then
                rootPart.CFrame = CFrame.new(nearest.Position + Vector3.new(0, 4, 0))
                pressE()
                task.wait(0.2)
            else
                task.wait(0.5)
            end
        end

        -- выключили — чистим платформы
        unwatchHoneycombs()
    end)
end

local function stopBees()
    beeActive = false
    -- unwatchHoneycombs вызовется из task.spawn выше когда цикл завершится
end

-- ================================================
--   АНТИ-АФК
-- ================================================

local afkTimer     = 0
local AFK_INTERVAL = 900 -- 15 минут

local function startAntiAfk()
    afkConn = RunService.Heartbeat:Connect(function(dt)
        if not afkActive then return end
        afkTimer = afkTimer + dt
        if afkTimer < AFK_INTERVAL then return end
        afkTimer = 0
        -- прыгаем один раз
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Jump = true
        end
    end)
end

local function stopAntiAfk()
    afkActive = false
    if afkConn then afkConn:Disconnect(); afkConn = nil end
    afkTimer = 0
end

