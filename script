local function makeBtn(labelText, yPos)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0, 205, 0, 44)
    btn.Position         = UDim2.new(0.5, -102, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    btn.BorderSizePixel  = 0
    btn.Text             = "▶  " .. labelText .. "  [ВЫКЛ]"
    btn.TextColor3       = Color3.fromRGB(160, 160, 180)
    btn.Font             = Enum.Font.GothamSemibold
    btn.TextSize         = 12
    btn.Parent           = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent       = btn

    local s = Instance.new("UIStroke")
    s.Color     = Color3.fromRGB(60, 60, 90)
    s.Thickness = 1
    s.Parent    = btn

    return btn, s
end

